# ─── PaperGen Environment Configuration ─────────────────────────────────────
# Server Settings
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# Storage & Database Cache Settings
STORAGE_DIR=server_storage
DB_CACHE_FILE=.questions_db_cache.bin

# Frontend Client Settings (Vite requires VITE_ prefix for client-exposed variables)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_NAME="PaperGen Pro"
VITE_APP_VERSION="1.0.0"
